{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FEWSNET immutable source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "created_at_utc",
    "snapshot_content_sha256",
    "panel",
    "normalization_audit",
    "boundaries",
    "admin_universe",
    "row_count",
    "area_count",
    "spatial_feature_count",
    "crs",
    "latest_feature_month",
    "latest_label_month",
    "source_identity",
    "admin_code_mapping"
  ],
  "properties": {
    "schema_version": {
      "const": "fewsnet-source-snapshot-v2"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "panel": {
      "$ref": "#/$defs/objectRef"
    },
    "normalization_audit": {
      "$ref": "#/$defs/objectRef"
    },
    "boundaries": {
      "$ref": "#/$defs/objectRef"
    },
    "admin_universe": {
      "$ref": "#/$defs/objectRef"
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "area_count": {
      "type": "integer",
      "minimum": 0
    },
    "spatial_feature_count": {
      "type": "integer",
      "minimum": 0
    },
    "crs": {
      "type": "string",
      "minLength": 1
    },
    "latest_feature_month": {
      "$ref": "#/$defs/month"
    },
    "latest_label_month": {
      "$ref": "#/$defs/month"
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_bootstrap_path",
        "boundaries_bootstrap_path",
        "panel_source_type",
        "boundaries_source_type"
      ],
      "properties": {
        "panel_bootstrap_path": {
          "type": "string",
          "minLength": 1
        },
        "boundaries_bootstrap_path": {
          "type": "string",
          "minLength": 1
        },
        "panel_source_type": {
          "type": "string",
          "minLength": 1
        },
        "boundaries_source_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "admin_code_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel",
        "boundaries",
        "canonical"
      ],
      "properties": {
        "panel": {
          "type": "string",
          "minLength": 1
        },
        "boundaries": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "generation",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^gs://[^/]+/.+"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
