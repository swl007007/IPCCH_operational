 "predecessor_workflow_source": "# October delivery trigger: Cloud Storage object.v1.finalized (Eventarc) -> this workflow -> Cloud Run job.\n# Only gs://<bucket>/requests/<run_id>/run_manifest.json starts work; every other object (reports,\n# sources, outputs) is ignored. The event's exact generation is passed through; the job never reads\n# a \"latest\" request. Submission is not success: the run's status object is the durable outcome.\n# The job is configured with --max-retries 0 (deploy_delivery.sh): a failed run is never resumed;\n# retry = new run ID. Duplicate events for the same generation return the original status.\nmain:\n  params: [event]\n  steps:\n    - init:\n        assign:\n          - project: ${sys.get_env(\"GOOGLE_CLOUD_PROJECT_ID\")}\n          - location: ${sys.get_env(\"DELIVERY_LOCATION\")}\n          - job: ${sys.get_env(\"DELIVERY_JOB\")}\n          # Container overrides REPLACE the job's args, so the full argv is rebuilt here from the\n          # configured deployment values (never from the event) plus the event's exact request.\n          - output_root: ${sys.get_env(\"DELIVERY_OUTPUT_ROOT\")}\n          - release_namespace: ${sys.get_env(\"DELIVERY_RELEASE_NAMESPACE\")}\n          - image_uri: ${sys.get_env(\"DELIVERY_IMAGE_URI\")}\n          - bucket: ${event.data.bucket}\n          - name: ${event.data.name}\n          - generation: ${string(event.data.generation)}\n    - filter:\n        switch:\n          - condition: ${not(text.match_regex(name, \"^requests/[a-z0-9][a-z0-9._-]{2,62}/run_manifest\\\\.json$\"))}\n            return: ${\"ignored \" + name}\n          - condition: ${not(text.match_regex(generation, \"^[1-9][0-9]*$\"))}\n            raise: ${\"event without an exact generation for \" + name}\n    - run_job:\n        call: googleapis.run.v2.projects.locations.jobs.run\n        args:\n          name: ${\"projects/\" + project + \"/locations/\" + location + \"/jobs/\" + job}\n          body:\n            overrides:\n              containerOverrides:\n                - args:\n                    - \"-m\"\n                    - \"cloud.orchestrator.delivery_job\"\n                    - \"run\"\n                    - \"--request-uri\"\n                    - ${\"gs://\" + bucket + \"/\" + name}\n                    - \"--request-generation\"\n                    - ${generation}\n                    - \"--output-root\"\n                    - ${output_root}\n                    - \"--release-namespace\"\n                    - ${release_namespace}\n                    - \"--image-uri\"\n                    - ${image_uri}\n          connector_params:\n            # Submit only: the run's status object (runs/<run_id>/run_status.json) is the durable outcome.\n            # Polling the long-running operation would need project-level run.operations.get.\n            skip_polling: true\n        result: execution\n    - done:\n        return: ${execution}\n",
