# command: /home/swl007007/.venvs/fewsnet-test-lock-20261022/bin/python -c import csv,hashlib,io,json
from pathlib import Path
p=Path(".trellis/tasks/10-30-ipcch-real-e2e-integration/research/cp4")
bundle=Path("/home/swl007007/ipcch-operator/food-crisis-test/v2-build/cp4-115798f-20261031T135044Z/tmp.oV5ZoayeBG/ipcch/handoff-bundle/handoff_manifest.json")
raw=bundle.read_bytes()
assert hashlib.sha256(raw).hexdigest()=="e6e3ebc60ad816bda4580cf3cef65258ba1cb708a4766d9f4d76fbd13f5c97b4"
manifest=json.loads(raw)
inv=json.loads((p/"cp5/inventory-post-init-real.json").read_text())
expected={k[:-4].replace("/","__"): (k,v) for k,v in manifest["files"].items() if not k.startswith("audit/") and k.endswith(".csv")}
assert set(inv["tables"])==set(expected)|{"acceptance_manifest","combination_binding"}
assert not inv["orphan_version_tables"]
for table,(rel,entry) in expected.items():
 actual=inv["tables"][table]
 assert actual["record"]["source"]==rel,table
 assert actual["record"]["source_sha256"]==entry["sha256"],table
 assert actual["rows"]==entry["rows"],table
 assert actual["version"]==1 and actual["version_objects"]==1,table
 assert actual["content"].startswith(inv["root"]+"/"+table+"/versions/"),table
pair=list(csv.DictReader(io.StringIO(inv["tables"]["combination_binding"]["content_text"])))
assert len(pair)==1
pair=pair[0]
assert pair["bundle_manifest_sha256"]==hashlib.sha256(raw).hexdigest()
assert pair["package_manifest_sha256"]=="18b91d454163ac9ff9833d8127108e731b2f9d95069fb26fd5e7e8877a115f22"
assert pair["feature_order_sha256"]=="0ef1ffeca07542b313c3f28ccf9445231e7b59e2d866cdd3862a7c3feafe3d69"
assert pair["roster_sha256"]==manifest["roster_sha256"] and int(pair["roster_size"])==6226
print(json.dumps({"passed":True,"runtime_tables":len(expected),"total_heads":inv["table_count"],"binding":pair},sort_keys=True))

