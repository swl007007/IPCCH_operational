from google.cloud import storage
out=pathlib.Path('/mnt/c/users/swl00/ifpri dropbox/weilun shi/ipcch_monthly_operational/.trellis/tasks/10-31-ipcch-all-keep-incremental-release/research/acled-date-check')
f=pathlib.Path('/home/swl007007/ipcch-operator/food-crisis-test/v2-inputs/real-20261031/acled_regional_aggregate_f2f3.csv')
h=hashlib.sha256()
with f.open('rb') as stream:
 for block in iter(lambda:stream.read(1048576),b''): h.update(block)
assert h.hexdigest()=='7bcb051fb3569f09cdec7f840c67d4666e586cbffd77b0d3b4a8feaf95e2fce6'
minimum=None; maximum=None; count=0; regions=set()
with f.open(encoding='utf-8-sig',newline='') as stream:
 for row in csv.DictReader(stream):
  week=datetime.date.fromisoformat(row['week'])
  assert week.weekday()==5
  minimum=week if minimum is None else min(minimum,week)
  maximum=week if maximum is None else max(maximum,week)
  regions.add(row['region']);count+=1
report={'checked_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'raw_file':str(f),'sha256':h.hexdigest(),'raw_rows':count,'week_min':minimum.isoformat(),'week_max':maximum.isoformat(),'last_week_end':(maximum+datetime.timedelta(days=6)).isoformat(),'regions':sorted(regions)}
client=storage.Client(project='feisty-flames-511718-d4')
blob=client.bucket('food-crisis-test-ipcch-data').blob('ipcch-v2/real/acled_agg_weekly/HEAD.json')
blob.reload(timeout=30,retry=None)
generation=int(blob.generation)
raw=blob.download_as_bytes(if_generation_match=generation,timeout=30,retry=None)
head=json.loads(raw)
(out/'live-head.json').write_bytes(raw)
coverage=head.get('record',{}).get('coverage',[])
assert coverage,'No saved coverage records'
report['live_head']={'uri':'gs://food-crisis-test-ipcch-data/ipcch-v2/real/acled_agg_weekly/HEAD.json','generation':str(generation),'version':head['version'],'rows':head.get('rows'),'coverage':coverage,'latest_declared_end':max(r['end'] for r in coverage)}
report['matches_imported_source']=any(r.get('source',{}).get('sha256')==h.hexdigest() for r in coverage)
(out/'result.json').write_text(json.dumps(report,indent=2))
print(json.dumps(report,indent=2))

