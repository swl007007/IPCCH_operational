from pathlib import Path
raw=Path(sys.argv[1]).read_bytes()
assert hashlib.sha256(raw).hexdigest()==sys.argv[3]
manifest=json.loads(raw); inv=json.loads(Path(sys.argv[2]).read_text())
expected={k[:-4].replace("/","__"):(k,v) for k,v in manifest["files"].items() if not k.startswith("audit/") and k.endswith(".csv")}
assert set(inv["tables"])==set(expected)|{"acceptance_manifest","combination_binding"}
assert not inv["orphan_version_tables"]
for table,(rel,entry) in expected.items():
 a=inv["tables"][table]
 assert a["record"]["source"]==rel and a["record"]["source_sha256"]==entry["sha256"],table
 assert a["rows"]==entry["rows"],table
 assert a["version"]==1 and a["version_objects"]==1,table
 assert a["content"].startswith(inv["root"]+"/"+table+"/versions/"),table
pair=list(csv.DictReader(io.StringIO(inv["tables"]["combination_binding"]["content_text"])))
assert len(pair)==1
pair=pair[0]
assert pair["bundle_manifest_sha256"]==sys.argv[3]
assert pair["package_manifest_sha256"]=="18b91d454163ac9ff9833d8127108e731b2f9d95069fb26fd5e7e8877a115f22"
assert pair["feature_order_sha256"]=="0ef1ffeca07542b313c3f28ccf9445231e7b59e2d866cdd3862a7c3feafe3d69"
assert pair["roster_sha256"]==manifest["roster_sha256"] and int(pair["roster_size"])==int(sys.argv[4])
print(json.dumps({"passed":True,"runtime_tables":len(expected),"total_heads":inv["table_count"],"binding":pair},sort_keys=True))
