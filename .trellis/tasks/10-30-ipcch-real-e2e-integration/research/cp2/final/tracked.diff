+class Writes(Spy):
+    """Store wrapper recording mutations only."""
+
+    def __getattr__(self, name):
+        attr = getattr(self.inner, name)
+        if name in ("write_text", "write_bytes", "copy", "delete"):
+            def call(*a, **k):
+                self.touched.append((name, a[0] if a else None))
+                return attr(*a, **k)
+            return call
+        return attr
+
